# 1. Supabase Cloud Database & Storage Credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# 2. Chapter Leadership Administrator Key (Optional override)
VITE_ADMIN_PASSKEY=your_admin_passkey

# 3. A.R.I.A. Intelligence Engine (Vercel Serverless / Backend)
# Never prefix with VITE_ to prevent exposing it in client-side bundles
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_optional_llm_key_here
